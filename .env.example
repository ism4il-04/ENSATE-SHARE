# Copy to .env.development.local for local work. Never commit real values.

# Neon Postgres, *pooled* connection string (host ends in -pooler). Local: the dev branch only.
DATABASE_URL=

# Signs session cookies (at least 32 random characters). Different value in production.
SESSION_SECRET=

# Sent by Vercel Cron to /api/cron/daily (random value)
CRON_SECRET=

# Google Drive storage (OAuth client + refresh token of the ADE Drive account)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Sign in with Google (Web application client ID; same value in both)
GOOGLE_AUTH_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional upload limits
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=pdf,docx,pptx,xls,xlsx,zip,jpg,jpeg,png,gif

# Environment
NODE_ENV=development

# Server
PORT=5000

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ensa-share?retryWrites=true&w=majority

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=24h


# File Upload
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=pdf,docx,pptx,xls,xlsx,zip,jpg,jpeg,png,gif

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Sign in with Google (OAuth "Web application" client ID; same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_AUTH_CLIENT_ID=
